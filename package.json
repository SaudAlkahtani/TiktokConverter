{
  "name": "local-video-converter",
  "version": "1.0.0",
  "private": true,
  "description": "Local file-upload video converter with a 1080p60 export profile",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "doctor": "node src/doctor.js",
    "editor:plan": "node scripts/render-editor-plan.js",
    "editor:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-editor-desktop.ps1",
    "editor:shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-editor-shortcut.ps1"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.1.1",
    "@remotion/bundler": "4.0.541",
    "@remotion/renderer": "4.0.541",
    "dotenv": "^16.6.1",
    "fastify": "^5.5.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "grammy": "^1.38.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.541"
  }
}
