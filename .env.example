# The local server listens only on 127.0.0.1.
PORT=4173
# Explicit paths are useful if FFmpeg is not on PATH.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Screenshot-matched HEVC delivery profile. On Windows, libx265 replaces the
# macOS-only hevc_videotoolbox encoder while keeping the HEVC/hvc1 output.
VIDEO_CODEC=libx265
# 60 fps HEVC exports use a 20 Mbps target bitrate.
VIDEO_BITRATE=20M
VIDEO_GOP=60
# Moderate detail enhancement, matching the reference command. Leave blank to disable.
VIDEO_SHARPEN=unsharp=3:3:0.4:3:3:0.4
# Matches the reference command's -itsscale 2 (half-speed playback).
VIDEO_TIMESTAMP_SCALE=2
# Maximum original clip size accepted by the worker. 0 defaults to 20 GB.
MAX_INPUT_GB=0
MEDIA_ROOT=
