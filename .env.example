# The local server listens only on 127.0.0.1.
PORT=4173
# Explicit paths are useful if FFmpeg is not on PATH.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Standard export: H.264 1080x1920. TikTok uses 60 fps / 25 Mb/s with
# 2x timeline for 60 fps sources; Instagram always uses 30 fps / 15 Mb/s
# with normal timing.
# Legacy VIDEO_* settings from other branches are ignored here.
# Maximum original clip size accepted by the worker. 0 defaults to 20 GB.
MAX_INPUT_GB=0
# Maximum videos in one standard converter upload (1-100). The editor has no fixed source-count cap.
MAX_UPLOAD_FILES=20
MEDIA_ROOT=

# Automatic face detection only. Use a Python installation with OpenCV and NumPy.
EDITOR_PYTHON=python
