# The local server listens only on 127.0.0.1.
PORT=4173
# Explicit paths are useful if FFmpeg is not on PATH.
FFMPEG_PATH=
FFPROBE_PATH=

# Python 3.10+ required. Blank uses python on PATH; or set an executable path.
PYTHON_PATH=
# Khaled profile: H.264 CRF 17 slow, normal speed, source fps up to 120.
# Old VIDEO_* settings are ignored on this branch.
# Prepared MP4 must be <=1 GB for the in-memory container patcher.
# Maximum original clip size accepted by the worker. 0 defaults to 20 GB.
MAX_INPUT_GB=0
MEDIA_ROOT=
