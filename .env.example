# The local server listens only on 127.0.0.1.
PORT=4173
# Explicit paths are useful if FFmpeg is not on PATH.
FFMPEG_PATH=
FFPROBE_PATH=

# Quality-based HEVC software encoding (slow preset). Lower CRF = larger files.
# Original displayed resolution is preserved; bitrate adapts to image detail.
VIDEO_CRF=18
VIDEO_GOP=60
# Default playback choice; the dashboard can override this per upload.
# 2 keeps the previous half-speed reference mode; 1 is normal playback.
VIDEO_TIMESTAMP_SCALE=2
# Maximum original clip size accepted by the worker. 0 defaults to 20 GB.
MAX_INPUT_GB=0
MEDIA_ROOT=
