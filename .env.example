# Create a NEW dedicated bot in @BotFather for this exporter. Do not use
# @BigBoiSaud_bot or its token: that bot stays exclusively with OpenClaw.
TELEGRAM_BOT_USERNAME=@YOUR_NEW_EXPORTER_BOT
TELEGRAM_BOT_TOKEN=

# Start with the official cloud endpoint for a quick bot test. Change this to
# http://127.0.0.1:8081 after completing the Local Bot API setup for 4K files.
TELEGRAM_API_ROOT=https://api.telegram.org

# Comma-separated numeric Telegram chat IDs that may submit clips. Blank allows
# the first chat, which is convenient while testing but not recommended long term.
ALLOWED_CHAT_IDS=

PORT=4173
# Explicit paths are useful if FFmpeg is not on PATH.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# TikTok conversion is locked to commit 6378e68; conflicting overrides reject startup.
VIDEO_CODEC=libx265
VIDEO_BITRATE=20M
VIDEO_GOP=60
VIDEO_SHARPEN=unsharp=3:3:0.4:3:3:0.4
VIDEO_TIMESTAMP_SCALE=2
# Maximum original clip size accepted by the worker (0 = unlimited).
MAX_INPUT_GB=0
MEDIA_ROOT=
DELETE_SOURCE_AFTER_SEND=true
