# The local server listens only on 127.0.0.1.
PORT=4173
# Explicit paths are useful if FFmpeg is not on PATH.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Locked TikTok preset from commit 6378e68. Conflicting values stop the app.
# Instagram and the editor master keep their separate presets.
VIDEO_CODEC=libx265
VIDEO_BITRATE=20M
VIDEO_GOP=60
VIDEO_SHARPEN=unsharp=3:3:0.4:3:3:0.4
VIDEO_TIMESTAMP_SCALE=2
# Maximum original clip size accepted by the worker. 0 defaults to 20 GB.
MAX_INPUT_GB=0
# Maximum number of videos accepted in one browser upload (1-100).
MAX_UPLOAD_FILES=20
MEDIA_ROOT=

# Automatic face detection only. Use a Python installation with OpenCV and NumPy.
EDITOR_PYTHON=python
