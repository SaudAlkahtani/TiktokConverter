# The local server listens only on 127.0.0.1.
PORT=4173
# Explicit paths are useful if FFmpeg is not on PATH.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# TikTok delivery settings are locked to commit 6378e68. Conflicting values
# prevent startup so local and Telegram exports cannot silently diverge.
VIDEO_CODEC=libx265
VIDEO_BITRATE=20M
VIDEO_GOP=60
VIDEO_SHARPEN=unsharp=3:3:0.4:3:3:0.4
# Half-speed timestamps apply to video and source audio.
VIDEO_TIMESTAMP_SCALE=2
# Maximum original clip size accepted by the worker. 0 defaults to 20 GB.
MAX_INPUT_GB=0
# Maximum number of videos accepted in one browser upload (1-100).
MAX_UPLOAD_FILES=20
MEDIA_ROOT=

# Optional dedicated exporter bot. Never reuse OpenClaw's token.
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
# Local Bot API is required for large original videos; standard API downloads
# are limited to 20 MB. Enable the official WSL server first.
TELEGRAM_API_ROOT=http://127.0.0.1:8081
WSL_DISTRIBUTION=Ubuntu-24.04
# Restrict use to comma-separated numeric chat IDs. Blank permits all chats.
TELEGRAM_ALLOWED_CHAT_IDS=
DELETE_SOURCE_AFTER_SEND=true

# TikTok is locked until all setup/verification requirements are met.
# The @handle is required; the display name is not unique.
TIKTOK_HANDLE=sauds.journey
TIKTOK_ALLOWED_USER_IDS=
TIKTOK_TIMEZONE=Asia/Riyadh
TIKTOK_BROWSER_CHANNEL=msedge
